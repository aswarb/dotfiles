(deflisten focusedProgram
  :initial ""
  "scripts/dwl_getFocusedProgram.sh"
)

(deflisten allWorkspaces
  :initial "[1]"
  "scripts/dwl_getWorkspaces.sh"
)

(deflisten activeWorkspaces
  :initial "[]"
  "scripts/dwl_getActiveWorkspace.sh"
)

(deflisten focusedWorkspace
  :initial "1"
  "scripts/dwl_getFocusedWorkspace.sh"
)

(defvar roman_numerals '{"1":"I","2":"II","3":"III","4":"IV","5":"V","6":"VI","7":"VII","8":"VIII","9":"IX","10":"X"}')

(deflisten focusedLayout
  :initial "[]="
  "scripts/dwl_getLayout.sh"
)

(deflisten focusedMonitor
  :initial "0"
  "scripts/dwl_getFocusedMonitor.sh"
)
