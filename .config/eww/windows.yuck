;; =========================================================================
;; Windows
;; =========================================================================
;; Bars are docks with struts, so clients tile around them. Popups are not:
;; they overlay, and they close when something else opens.
;;
;; 24px, as the panel specifies. It was 20px, which left ~18px of usable
;; height once the 2px underline gutter on a bar item was taken out -- not
;; enough for a Nerd Font glyph, which is drawn to fill its cell, so the power
;; icon was clipping top and bottom.

;; ---- bars ---------------------------------------------------------------
(defwindow top0
  :monitor 0 :windowtype "dock" :exclusive true :namespace "bar"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "24px" :anchor "top center")
  :reserve (struts :side "top" :distance "4%")
  (topBar))

(defwindow bottom0
  :monitor 0 :windowtype "dock" :exclusive true :namespace "bar"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "24px" :anchor "bottom center")
  :reserve (struts :side "bottom" :distance "4%")
  (bottomBar))

(defwindow top1
  :monitor 1 :windowtype "dock" :exclusive true :namespace "bar"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "24px" :anchor "top center")
  :reserve (struts :side "top" :distance "4%")
  (topBar))

(defwindow bottom1
  :monitor 1 :windowtype "dock" :exclusive true :namespace "bar"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "24px" :anchor "bottom center")
  :reserve (struts :side "bottom" :distance "4%")
  (bottomBar))

;; ---- popups -------------------------------------------------------------
;; "popups drop from the item that opened them", so the calendar is centred
;; under the clock and the control centre is pinned to the right under the
;; power glyph.
;;
;; y is the gap under the bar -- keep it in step with $popup-gap in
;; styles/_tokens.scss. They do not butt against the bar: the accent rule on
;; the open item reads as the bar's own bottom edge, and the popup hangs
;; below it.
;;
;; Per-monitor popups: we create one per monitor so the popup appears on the
;; monitor where the button was pressed. The open script (scripts/popup.sh)
;; picks the right one based on focusedMonitor.
(defwindow calendar0
  :monitor 0 :windowtype "dialog" :exclusive false :namespace "popup"
  :stacking "overlay" :focusable false
  :geometry (geometry :x "0px" :y "3px" :width "300px" :anchor "top center")
  (calendarPopup))

(defwindow calendar1
  :monitor 1 :windowtype "dialog" :exclusive false :namespace "popup"
  :stacking "overlay" :focusable false
  :geometry (geometry :x "0px" :y "3px" :width "300px" :anchor "top center")
  (calendarPopup))

(defwindow control0
  :monitor 0 :windowtype "dialog" :exclusive false :namespace "popup"
  :stacking "overlay" :focusable false
  :geometry (geometry :x "8px" :y "3px" :width "320px" :anchor "top right")
  (controlPopup))

(defwindow control1
  :monitor 1 :windowtype "dialog" :exclusive false :namespace "popup"
  :stacking "overlay" :focusable false
  :geometry (geometry :x "8px" :y "3px" :width "320px" :anchor "top right")
  (controlPopup))

;; ---- misc ---------------------------------------------------------------
(defwindow genericWindow
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "1200px" :height "150px" :anchor "top left")
  (bottomBar))
